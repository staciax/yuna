{
  "name": "yuna-backend",
  "version": "0.0.1",
  "description": "Yuna Backend",
  "author": "STACiA <stacia.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/staciax/yuna.git"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
    "lint": "biome check . && biome format .",
    "format": "biome check --write . && biome format . --write",
    "email": "email dev --dir src/emails"
  },
  "dependencies": {
    "@elysiajs/cors": "~1.3.3",
    "@elysiajs/jwt": "~1.3.0",
    "@elysiajs/opentelemetry": "^1.3.0",
    "@elysiajs/static": "~1.3.0",
    "@elysiajs/swagger": "~1.3.0",
    "@prisma/client": "~6.8.2",
    "@react-email/components": "0.0.41",
    "elysia": "~1.3.1",
    "logixlysia": "~5.0.0",
    "nodemailer": "~7.0.3",
    "react": "~19.1.0",
    "react-dom": "~19.1.0",
    "ulid": "~3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "~1.9.4",
    "@types/bun": "~1.2.14",
    "@types/nodemailer": "~6.4.17",
    "@types/react": "~19.1.5",
    "@types/react-dom": "~19.1.5",
    "prisma": "~6.8.2",
    "react-email": "4.0.15",
    "sql-formatter": "^15.6.2"
  },
  "overrides": {
    "jose": "~6.0.11"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  },
  "module": "src/index.ts"
}
