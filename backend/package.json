{
    "name": "yuna-backend",
    "version": "0.0.1",
    "description": "Yuna Backend",
    "author": "STACiA <stacia.dev@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/staciax/yuna.git"
    },
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "NODE_ENV=production bun src/index.ts",
        "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
        "lint": "biome check . && biome format .",
        "format": "biome check --write . && biome format . --write",
        "email": "email dev --dir src/emails"
    },
    "dependencies": {
        "@elysiajs/cors": "~1.2.0",
        "@elysiajs/jwt": "~1.2.0",
        "@elysiajs/static": "~1.2.0",
        "@elysiajs/swagger": "~1.2.2",
        "@prisma/client": "~6.6.0",
        "@react-email/components": "0.0.34",
        "elysia": "~1.2.25",
        "logixlysia": "~4.1.2",
        "nodemailer": "~6.10.0",
        "react": "~19.1.0",
        "react-dom": "~19.1.0",
        "ulid": "^3.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "~1.9.4",
        "@types/bun": "~1.2.10",
        "@types/nodemailer": "~6.4.17",
        "@types/react": "~19.0.12",
        "@types/react-dom": "~19.0.4",
        "prisma": "~6.6.0",
        "react-email": "4.0.2",
        "sql-formatter": "^15.5.2"
    },
    "overrides": {
        "jose": "~5.9.6"
    },
    "peerDependencies": {
        "typescript": "^5.7.3"
    },
    "module": "src/index.ts"
}
