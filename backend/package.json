{
    "name": "yuna-backend",
    "version": "0.0.1",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "NODE_ENV=production bun src/index.ts",
        "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
        "lint": "biome check . && biome format .",
        "format": "biome check --write . && biome format . --write"
    },
    "dependencies": {
        "@elysiajs/cors": "~1.2.0",
        "@elysiajs/jwt": "~1.2.0",
        "@elysiajs/static": "~1.2.0",
        "@elysiajs/swagger": "~1.2.0",
        "@prisma/client": "~6.3.1",
        "elysia": "~1.2.12",
        "logixlysia": "~4.1.1",
        "nodemailer": "~6.10.0"
    },
    "devDependencies": {
        "@biomejs/biome": "~1.9.4",
        "@types/bun": "~1.2.2",
        "@types/nodemailer": "~6.4.17",
        "prisma": "~6.3.1",
        "sql-formatter": "^15.4.10"
    },
    "module": "src/index.ts"
}
