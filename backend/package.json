{
    "name": "yuna-backend",
    "version": "0.0.1",
    "description": "Yuna Backend",
    "author": "STACiA <stacia.dev@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/staciax/yuna.git"
    },
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "NODE_ENV=production bun src/index.ts",
        "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/index.ts",
        "lint": "biome check . && biome format .",
        "format": "biome check --write . && biome format . --write",
        "email": "email dev --dir src/emails"
    },
    "dependencies": {
        "@elysiajs/cors": "~1.2.0",
        "@elysiajs/jwt": "~1.2.0",
        "@elysiajs/static": "~1.2.0",
        "@elysiajs/swagger": "~1.2.0",
        "@prisma/client": "~6.3.1",
        "elysia": "~1.2.13",
        "logixlysia": "~4.1.1",
        "nodemailer": "~6.10.0",
        "react": "~19.0.0",
        "react-dom": "~19.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "~1.9.4",
        "@types/bun": "~1.2.2",
        "@types/nodemailer": "~6.4.17",
        "@types/react": "~19.0.8",
        "@types/react-dom": "~19.0.3",
        "prisma": "~6.3.1",
        "react-email": "3.0.7",
        "sql-formatter": "^15.4.10"
    },
    "overrides": {
        "jose": "~5.9.6"
    },
    "module": "src/index.ts"
}
