PROJECT_NAME=yuuki
HOSTNAME=localhost
FRONTEND_HOST=http://localhost:3000

# Node environment: development, production, test
NODE_ENV=development

# Backend
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:8000
SECRET_KEY=yoursecretkey
 
# Database
POSTGRES_DB=yuna   
POSTGRES_USER=yuna
POSTGRES_PASSWORD=strongpassword

# Database URL for prisma please set the same value as POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
DATABASE_URL="postgresql://yuna:strongpassword@db:5432/yuna?schema=public"

# SMTP
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
EMAILS_FROM_EMAIL=test@test.com
EMAILS_FROM_NAME=test


# S3
S3_BUCKET=yuna
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
# S3_SESSION_TOKEN=
# S3_VIRTUAL_HOSTED_STYLE=
# S3_ACL=

# Docker registry images
DOCKER_IMAGE_BACKEND=backend